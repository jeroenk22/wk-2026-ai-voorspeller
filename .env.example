# ── Anthropic API ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ── API Football (RapidAPI) ────────────────────────────
# Gratis tier: ~100 calls/dag — ruim voldoende
# Account aanmaken op: https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# ── Backend ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Cache (optioneel) ──────────────────────────────────
# Voorkomt onnodige API calls tijdens ontwikkeling
CACHE_TTL_SECONDS=3600

# ── Netlify (automatisch beschikbaar in Netlify omgeving) ─
# Stel in via: Netlify Dashboard → Site settings → Environment variables
# ANTHROPIC_API_KEY=...
# API_FOOTBALL_KEY=...
# CLAUDE_MODEL=claude-sonnet-4-6
